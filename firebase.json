{
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "firestore": [
    {
      "database": "db-lms-project",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "functions": [
    {
      "source": "backend",
      "codebase": "backend",
      "runtime": "python311"
    }
  ],
  "apphosting": [
    {
      "backendId": "lms-frontend",
      "rootDir": "frontend",
      "ignore": [
        "node_modules",
        ".git",
        ".env",
        ".env.*",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "functions"
      ]
    }
  ]
}
